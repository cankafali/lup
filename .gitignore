# Git'e girmeyecek dosyalar. Hepsi yeniden üretilebilir ya da kişiye/makineye özel.

# Bağımlılıklar (pnpm install ile gelir)
/node_modules

# Next.js derleme çıktısı (pnpm build / pnpm dev ile oluşur)
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# Test çıktıları (Vitest, Playwright)
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Ortam değişkenleri: gizli bilgi taşıyabilir. Örnek dosya paylaşılabilir.
.env*
!.env.example

# Vercel (npx vercel ile oluşur, projeye bağlantı bilgisi)
.vercel

# Günlükler
*.log

# Sertifika ve anahtarlar
*.pem

# İşletim sistemi
.DS_Store
Thumbs.db
desktop.ini

# Editörler
.vscode/
.idea/

# Yapay zekâ asistanının yerel ayarları
.claude/
